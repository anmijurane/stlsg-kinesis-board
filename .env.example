# Copiar a .env.local. Sustituir los marcadores por credenciales locales.
# Aplicación Next.js: usar un rol con permisos de lectura sobre los datos necesarios.
DATABASE_URL=postgresql://app_reader:CHANGE_ME@localhost:0000/db

# MCP: usar un rol independiente de solo lectura.
# Next.js no transmite esta variable al proceso de Codex; consultar README.md.
DATABASE_URI=postgresql://mcp_reader:CHANGE_ME@localhost:0000/db
